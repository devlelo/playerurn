{
  "version": 2,
  "platforms": {
    "PSP": {
      "engine": "PPSSPP WebAssembly",
      "project": "https://github.com/root-hunter/ppsspp-web",
      "license": "GPL-2.0-or-later",
      "integration": "same-origin-reverse-proxy",
      "route": "/engines/psp/",
      "gameFileInput": "#libraryImportFile",
      "offline": "runtime-assets-cached-after-first-online-load",
      "status": "wired"
    },
    "SEGA": {
      "engine": "Sandopolis",
      "project": "https://github.com/pixel-clover/sandopolis",
      "license": "MIT",
      "integration": "same-origin-reverse-proxy",
      "route": "/engines/sega/",
      "gameFileInput": "#rom-input",
      "offline": "runtime-assets-cached-after-first-online-load",
      "status": "wired-with-alpha-compatibility-warning"
    },
    "HTML": {
      "engine": "Playerun HTML5 Sandbox",
      "runtime": "sandboxed-iframe-srcdoc",
      "status": "local"
    }
  },
  "notes": [
    "PSP and Sega run with different emulator projects; they do not share EmulatorJS.",
    "The browser displays the emulator under the Playerun origin using Vercel rewrites.",
    "The first engine load requires internet; same-origin runtime files can then be cached by the Playerun service worker.",
    "Game ROMs and BIOS files are not included."
  ]
}