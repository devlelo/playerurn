{
  "version": 2,
  "platforms": {
    "PSP": {
      "engine": "PPSSPP WebAssembly",
      "project": "https://github.com/root-hunter/ppsspp-web",
      "license": "GPL-2.0-or-later",
      "integration": "same-origin-reverse-proxy",
      "route": "/engines/psp/index.html",
      "gameFileInput": "#libraryImportFile",
      "offline": "runtime-assets-cached-after-first-online-load",
      "status": "wired"
    },
    "SEGA": {
      "engine": "Sandopolis",
      "project": "https://github.com/pixel-clover/sandopolis",
      "license": "MIT",
      "integration": "same-origin-reverse-proxy",
      "route": "/engines/sega/index.html",
      "gameFileInput": "#rom-input",
      "offline": "runtime-assets-cached-after-first-online-load",
      "status": "wired-with-alpha-compatibility-warning"
    },
    "HTML": {
      "engine": "Playerun HTML5 Sandbox",
      "runtime": "sandboxed-iframe-srcdoc",
      "status": "local"
    },
    "PS1": {
      "engine": "EmulatorJS · PSX core",
      "integration": "in-app-core",
      "route": "#emulador-ps1",
      "gameFileInput": "Playerun local library",
      "offline": "emulator runtime requires first online load",
      "status": "configured"
    }
  },
  "notes": [
    "PSP uses PPSSPP WebAssembly; Sega uses Sandopolis; PlayStation 1 uses the PSX core in EmulatorJS.",
    "Each emulator has a dedicated Playerun page and a platform-specific folder in the selected game directory.",
    "Online downloads are stored in IndexedDB and optionally copied to the matching folder when folder access is granted.",
    "First-time emulator assets require internet. ROMs and BIOS files are not bundled."
  ]
}